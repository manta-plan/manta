# Overrides for the integration test stack only (see compose-test-services.yaml).
# Loaded on top of backend/.env, so only values that must differ from dev
# belong here. Port 0 tells Docker to assign a free ephemeral host port,
# so a test run never clashes with a locally running dev stack.
POSTGRES_PORT=0
S3_PORT=0
SEAWEEDFS_ADMIN_PORT=0
PREFECT_PORT=0
KEYCLOAK_PORT=0

# The test stack has its own compose project name (manta-test), so the network
# that job containers must join is named after it.
MANTA_DOCKER_NETWORK=manta-test_default

# The orchestrator worker's polling and log-shipping intervals, lowered from
# Prefect's production-tuned defaults so a test run isn't dominated by them.
PREFECT_WORKER_QUERY_SECONDS=1
PREFECT_LOGGING_TO_API_BATCH_INTERVAL=0.5
