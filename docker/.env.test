# Overrides for the integration test stack only (see compose-test-services.yaml).
# Loaded on top of backend/.env, so only values that must differ from dev
# belong here. Port 0 tells Docker to assign a free ephemeral host port,
# so a test run never clashes with a locally running dev stack.
POSTGRES_PORT=0
S3_PORT=0
SEAWEEDFS_ADMIN_PORT=0
PREFECT_PORT=0
