{
  "$defs": {
    "BlockStepDoc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_]\\w*$",
          "title": "Id",
          "type": "string"
        },
        "if": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "If"
        },
        "block": {
          "title": "Block",
          "type": "string"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        }
      },
      "required": [
        "id",
        "block"
      ],
      "title": "BlockStepDoc",
      "type": "object"
    },
    "BooleanInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "boolean",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "BooleanInput",
      "type": "object"
    },
    "ChoiceInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "choice",
          "title": "Type",
          "type": "string"
        },
        "options": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type",
        "options"
      ],
      "title": "ChoiceInput",
      "type": "object"
    },
    "InitialDataDoc": {
      "additionalProperties": false,
      "description": "What the data already looks like before the playbook starts.\n\nThe author of the playbook states these dimensions. We aim to drop this key once\nthe backend can read the data record itself. The dimensions check needs to know\nwhether a dimension is populated, and the manifest of the record shows only that\nthe dimension is recorded.",
      "properties": {
        "dims": {
          "items": {
            "type": "string"
          },
          "title": "Dims",
          "type": "array"
        }
      },
      "title": "InitialDataDoc",
      "type": "object"
    },
    "NumberInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "number",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "NumberInput",
      "type": "object"
    },
    "PlaybookDoc": {
      "additionalProperties": false,
      "description": "A whole playbook, as written down.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "initial_data": {
          "$ref": "#/$defs/InitialDataDoc"
        },
        "inputs": {
          "additionalProperties": false,
          "patternProperties": {
            "^[A-Za-z_]\\w*$": {
              "discriminator": {
                "mapping": {
                  "boolean": "#/$defs/BooleanInput",
                  "choice": "#/$defs/ChoiceInput",
                  "number": "#/$defs/NumberInput",
                  "string": "#/$defs/StringInput"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/StringInput"
                },
                {
                  "$ref": "#/$defs/NumberInput"
                },
                {
                  "$ref": "#/$defs/BooleanInput"
                },
                {
                  "$ref": "#/$defs/ChoiceInput"
                }
              ]
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "steps": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/BlockStepDoc"
              },
              {
                "$ref": "#/$defs/PlaybookStepDoc"
              }
            ]
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "name",
        "steps"
      ],
      "title": "PlaybookDoc",
      "type": "object"
    },
    "PlaybookStepDoc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z_]\\w*$",
          "title": "Id",
          "type": "string"
        },
        "if": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "If"
        },
        "playbook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/PlaybookDoc"
            }
          ],
          "title": "Playbook"
        },
        "with": {
          "additionalProperties": true,
          "title": "With",
          "type": "object"
        },
        "inputs": {
          "anyOf": [
            {
              "const": "inherit",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs"
        }
      },
      "required": [
        "id",
        "playbook"
      ],
      "title": "PlaybookStepDoc",
      "type": "object"
    },
    "StringInput": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "const": "string",
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "type"
      ],
      "title": "StringInput",
      "type": "object"
    }
  },
  "$ref": "#/$defs/PlaybookDoc"
}
