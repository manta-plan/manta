# Local development defaults only. Do NOT put real secrets in this file.
#
# This file is committed on purpose: none of these values are sensitive (a
# Postgres instance only ever reachable at localhost), so there's nothing to
# protect and nothing to manually copy/configure to get started.
#
# Production must NOT read this file — it needs a real secrets-management
# story (cloud secrets manager, Kubernetes Secrets, etc.), which doesn't
# exist yet.

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=manta
POSTGRES_PORT=5432

S3_PORT=8333
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_BUCKET=manta

SEAWEEDFS_ADMIN_PORT=23646

PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api

# The Prefect server's own database on the shared Postgres instance (see
# docker/conf/postgres-init/create-prefect-db.sh)
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=prefect
PREFECT_DB_NAME=prefect

# Playbook execution (see docker/compose-dev-services.yaml's "playbooks"
# profile, and runner/README.md). One image per block environment, so two
# frameworks that could never share a virtualenv can both appear in a playbook.
# Adding an environment means copying the block-image-builder compose service
# and adding an entry here in MANTA_ENV_IMAGES, which maps a block's declared
# environment to the image its steps run in.
MANTA_BLOCK_PREFECT_RUNTIME_IMAGE_PYPSA=block-prefect-runtime:pypsa
MANTA_ENV_IMAGES=pypsa=block-prefect-runtime:pypsa

# The image the provisioner and both playbook workers run
# (docker/runner-image.Dockerfile), and the two work pools: blocks get a
# container each, the playbook orchestration flow a long-lived process.
MANTA_RUNNER_IMAGE=runner:latest
MANTA_BLOCKS_POOL=manta-blocks
MANTA_PLAYBOOKS_POOL=manta-playbooks

# The compose network block containers join (named after the compose project),
# and the object-store endpoint as seen from inside those containers (the
# backend itself uses the host-published S3_PORT instead).
MANTA_DOCKER_NETWORK=manta_default
MANTA_JOB_S3_ENDPOINT=http://seaweedfs:8333

# Which block library a job container imports before looking anything up (see
# playbook.blocks.registry.load_block_sources), and which of its loggers ship
# to Prefect (it captures its own loggers and, with log_prints, anything
# printed — a modelling framework's own logging has to be named explicitly).
MANTA_BLOCK_SOURCES=playbook_library
MANTA_BLOCK_LOGGERS=playbook_library,pypsa,linopy

# KC_ variables directly impact the keycloak server config
# see: https://www.keycloak.org/server/all-config
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=kcpguser
KC_DB_PASSWORD=kcpgpass
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# KEYCLOAK_ variables affect how manta interacts with keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=manta
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcpassword

# The client ID and secret for the configured Identity Provider.
# (default: keycloak)
IDP_CLIENT_ID=manta-client
# Note that this needs to be kept in sync for dev/test purposes in docker/conf/manta-realm.json
IDP_CLIENT_SECRET=im-so-secret
APP_REDIRECT_URI=http://localhost:8000/*
