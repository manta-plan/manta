# Local development defaults only. Do NOT put real secrets in this file.
#
# This file is committed on purpose: none of these values are sensitive (a
# Postgres instance only ever reachable at localhost), so there's nothing to
# protect and nothing to manually copy/configure to get started.
#
# Production must NOT read this file — it needs a real secrets-management
# story (cloud secrets manager, Kubernetes Secrets, etc.), which doesn't
# exist yet.

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=manta
POSTGRES_PORT=5432

S3_PORT=8333
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_BUCKET=manta

SEAWEEDFS_ADMIN_PORT=23646

# Keycloak's own Postgres database. Option names must match Keycloak's
# `db-*` config keys exactly (KC_ + the key, uppercased, dots to underscores)
# — an unrecognised name is ignored silently and Keycloak falls back to the
# ephemeral embedded H2 database. See https://www.keycloak.org/server/db
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=kcpguser
KC_DB_PASSWORD=kcpgpass

# Required for the container healthcheck, which hits /health/ready on the
# management port (9000).
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

KEYCLOAK_PORT=8080
KEYCLOAK_REALM=manta

# Realm contents (clients, roles, dev users) live in
# docker/keycloak/manta-realm.json, imported on startup. These two are here
# because the app and frontend need them at runtime.
KEYCLOAK_FRONTEND_CLIENT_ID=manta-frontend
KEYCLOAK_API_AUDIENCE=manta-api
