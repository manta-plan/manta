# Local development defaults only. Do NOT put real secrets in this file.
#
# This file is committed on purpose: none of these values are sensitive (a
# Postgres instance only ever reachable at localhost), so there's nothing to
# protect and nothing to manually copy/configure to get started.
#
# Production must NOT read this file — it needs a real secrets-management
# story (cloud secrets manager, Kubernetes Secrets, etc.), which doesn't
# exist yet.

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=manta
POSTGRES_PORT=5432

S3_PORT=8333
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_BUCKET=manta

SEAWEEDFS_ADMIN_PORT=23646

# Example data (see "Example data" in backend/README.md). On startup, downloads
# the listed stores of the public test data bucket (all of them when empty;
# europe-full-res-2030 alone is ~125 MB, so it's left out) and creates
# manta-admin with its example project. Every newly registered user also gets an
# example project with a copy of them.
EXAMPLE_DATA_SEED=true
EXAMPLE_DATA_STORES=ac-dc-meshed,model-energy,BEL-pre-aggregated,BEL-pre-aggregated-hourly,BEL-pre-aggregated-incl-patches-incl-results,BEL-full-res
EXAMPLE_PROJECT_FOR_NEW_USERS=true

# Rate limits on POST /v1/auth/guest, which creates a Keycloak user per call
# without authentication. Kept in memory per process, over a sliding hour.
GUEST_LOGINS_PER_CLIENT_PER_HOUR=5
GUEST_LOGINS_PER_HOUR=100
# Reverse proxies whose X-Forwarded-For gives the client address the per-client
# limit is keyed on. Only the proxy itself: any other peer could set the header.
# compose-dev-backend.yaml sets the frontend Caddy's fixed address.
FORWARDED_ALLOW_IPS=127.0.0.1

# Where POST /v1/feedback forwards feedback (tools/feedback-apps-script). Real
# values belong in a deploy's own backend/.env, never in the repo. Without a
# URL the endpoint answers 503.
FEEDBACK_SCRIPT_URL=
FEEDBACK_SCRIPT_SECRET=

PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api

# The Prefect server's own database on the shared Postgres instance (see
# docker/conf/postgres-init/create-prefect-db.sh)
PREFECT_DB_USER=prefect
PREFECT_DB_PASSWORD=prefect
PREFECT_DB_NAME=prefect

# Playbook execution (see docker/compose-dev-services.yaml and
# runner/README.md). One image per block environment, so two
# frameworks that could never share a virtualenv can both appear in a playbook.
# Adding an environment means copying the block-image-builder compose service
# and adding an entry here in MANTA_ENV_IMAGES, which maps a block's declared
# environment to the image its steps run in.
MANTA_BLOCK_PREFECT_RUNTIME_IMAGE_PYPSA=block-prefect-runtime:pypsa
MANTA_ENV_IMAGES=pypsa=block-prefect-runtime:pypsa

# The image the provisioner and both playbook workers run
# (docker/runner-image.Dockerfile), and the two work pools: blocks get a
# container each, the playbook orchestration flow a long-lived process.
MANTA_RUNNER_IMAGE=runner:latest
MANTA_BLOCKS_POOL=manta-blocks
MANTA_PLAYBOOKS_POOL=manta-playbooks

# The compose network block containers join (named after the compose project),
# and the object-store endpoint as seen from inside those containers (the
# backend itself uses the host-published S3_PORT instead).
MANTA_DOCKER_NETWORK=manta_default
MANTA_JOB_S3_ENDPOINT=http://seaweedfs:8333

# Which block library a job container imports before looking anything up (see
# playbook.blocks.registry.load_block_sources), and which of its loggers ship
# to Prefect (it captures its own loggers and, with log_prints, anything
# printed — a modelling framework's own logging has to be named explicitly).
MANTA_BLOCK_SOURCES=playbook_library
MANTA_BLOCK_LOGGERS=playbook_library,pypsa,linopy

# KC_ variables directly impact the keycloak server config
# see: https://www.keycloak.org/server/all-config
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=kcpguser
KC_DB_PASSWORD=kcpgpass
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# KEYCLOAK_ variables affect how manta interacts with keycloak
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=manta
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcpassword

# The client ID and secret for the configured Identity Provider.
# (default: keycloak)
IDP_CLIENT_ID=manta-client
# Note that this needs to be kept in sync for dev/test purposes in docker/conf/manta-realm.json
IDP_CLIENT_SECRET=im-so-secret

# Where `uv run manta` serves the backend. Changing the port also means changing
# it in the frontend's dev proxy (frontend/vite.config.ts).
APP_HOST=127.0.0.1
APP_PORT=8000

# Host port of the containerised frontend (compose-dev-fullstack.yaml). `pnpm dev`
# keeps 5173, so both can run side by side.
FRONTEND_PORT=80

# HTTPS for a domain deploy. Leave SITE_ADDRESS empty for plain HTTP on
# FRONTEND_PORT (local, or behind a load balancer that terminates TLS). Set it
# to the domain name (e.g. manta.example.org) and the container's Caddy gets
# and renews a certificate; ports 80 and 443 must then be reachable from the
# internet. FRONTEND_HTTPS_PORT is the host port for 443.
SITE_ADDRESS=
FRONTEND_HTTPS_PORT=443

# TEMPORARY record server (docker/quack-server, compose profile
# temporary-quack-setup). Read by the compose files via --env-file.
# Host port of the record server; the frontend's Caddy uses the container port.
QUACK_SERVER_PORT=8010
# Also the frontend's token: built into its public bundle (VITE_RECORD_TOKEN is
# set from this by compose-dev-fullstack.yaml and vite.config.ts), so only a dev
# value belongs here.
QUACK_TOKEN=devtoken
