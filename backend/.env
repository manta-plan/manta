# Local development defaults only. Do NOT put real secrets in this file.
#
# This file is committed on purpose: none of these values are sensitive (a
# Postgres instance only ever reachable at localhost), so there's nothing to
# protect and nothing to manually copy/configure to get started.
#
# Production must NOT read this file — it needs a real secrets-management
# story (cloud secrets manager, Kubernetes Secrets, etc.), which doesn't
# exist yet.

POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=manta
POSTGRES_PORT=5432

S3_PORT=8333
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev
S3_BUCKET=manta

SEAWEEDFS_ADMIN_PORT=23646

PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api

# KC_ variables directly impact the keycloak server config
# see: https://www.keycloak.org/server/all-config
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=kcpguser
KC_DB_PASSWORD=kcpgpass
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# KEYCLOAK_ variables affect how manta interacts with keycloak
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=manta
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=kcpassword

# The client ID and secret for the configured Identity Provider.
# (default: keycloak)
IDP_CLIENT_ID=manta-client
# Note that this needs to be kept in sync for dev/test purposes in docker/conf/manta-realm.json
IDP_CLIENT_SECRET=im-so-secret
APP_REDIRECT_URI=http://localhost:8000/*
